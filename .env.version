# Jira Activity Analyzer local configuration template
# Copy this file to .env beside the executable or in APP_ROOT. Never commit .env.
ENV_FORMAT_VERSION=4

# Jira read-only connection
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_API_VERSION=2
JIRA_AUTH_MODE=bearer
LOCAL_DB_PATH=
LOCAL_DATABASE_PATH=

# ChatGPT authentication is managed by the bundled Codex App Server.
# No ChatGPT token, API key, Base URL, organization, or project belongs in .env.

# AI Nexus (OpenAI-compatible company service; secret stays in Electron main process)
AI_NEXUS_PROVIDER=AI Nexus
AI_NEXUS_ENDPOINT=
AI_NEXUS_MODEL=
AI_NEXUS_API_CONTRACT=chat_completions
AI_NEXUS_TOKEN=
AI_NEXUS_AUTH_TYPE=bearer
AI_NEXUS_ORGANIZATION=
AI_NEXUS_PROJECT=
AI_NEXUS_CONTEXT_WINDOW=
AI_NEXUS_REQUEST_TIMEOUT_MS=180000
AI_NEXUS_MAX_OUTPUT_TOKENS=4096
AI_NEXUS_MAX_RETRIES=2

# Separate AI analysis storage and rule set
AI_ANALYSIS_DB_PATH=app-data/ai-analysis/ai-analysis.sqlite3
AI_ANALYSIS_RULES_DIR=
LOG_LEVEL=DEBUG
